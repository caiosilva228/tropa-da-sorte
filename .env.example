# ==============================================================================
# TROPA DA SORTE - VARIÁVEIS DE AMBIENTE
# ==============================================================================

# URL da Aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Banco de Dados PostgreSQL / Supabase
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase (Opcional se usar PostgreSQL direto)
NEXT_PUBLIC_SUPABASE_URL="https://seu-projeto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua-chave-anonima-publica"
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-privada"

# Mercado Pago - Checkout Transparente & Webhook
NEXT_PUBLIC_MP_PUBLIC_KEY="APP_USR-xxxxxx-xxxxxx-xxxxxx"
MP_ACCESS_TOKEN="APP_USR-xxxxxx-xxxxxx-xxxxxx"
MP_WEBHOOK_SECRET="seu-segredo-de-webhook-mercadopago"

# Autenticação Administrativa
ADMIN_JWT_SECRET="chave-secreta-forte-para-tokens-jwt-admin-32-chars-min"

# Ambiente (development / production / sandbox)
NODE_ENV="development"
MP_ENVIRONMENT="sandbox"
